# Copy this file to .env and add only the settings you want to override.
# Fallback defaults are owned by src/job_scraper/config.py. Never commit .env.
OPENAI_API_KEY=

# Optional OpenAI overrides:
# JOB_SCRAPER_LLM_ENABLED=true
# JOB_SCRAPER_LLM_MODEL=gpt-5-nano
# JOB_SCRAPER_LLM_MONTHLY_BUDGET_USD=3.00
# JOB_SCRAPER_LLM_MAX_CALLS_PER_CYCLE=50
# JOB_SCRAPER_LLM_MAX_OUTPUT_TOKENS=6000
# JOB_SCRAPER_OPENAI_REQUEST_TIMEOUT_SECONDS=60

# Automatic enrichment controls:
# JOB_SCRAPER_ENRICHMENT_MAX_SECONDS=300
# JOB_SCRAPER_ENRICHMENT_BATCH_SIZE=10
# JOB_SCRAPER_ENRICHMENT_CURRENT_RUN_SHARE=70

# Optional scraping and logging overrides:
# JOB_SCRAPER_LINKEDIN_DESCRIPTION_LIMIT=50
# JOB_SCRAPER_INDEED_MAX_WORKERS=3
# JOB_SCRAPER_VERBOSE_LOGGING=true

# Optional email notification overrides:
# JOB_SCRAPER_EMAIL_ENABLED=true
# JOB_SCRAPER_EMAIL_FROM=sender@example.com
# JOB_SCRAPER_EMAIL_PASSWORD=app-password
# JOB_SCRAPER_EMAIL_TO=recipient@example.com
# JOB_SCRAPER_EMAIL_SMTP=smtp.example.com
