# Copy this file to .env and add your real API key. Never commit .env.
OPENAI_API_KEY=
JOB_SCRAPER_LLM_ENABLED=false
JOB_SCRAPER_LLM_MODEL=gpt-5-nano
JOB_SCRAPER_LLM_MONTHLY_BUDGET_USD=3.00
JOB_SCRAPER_LLM_MAX_CALLS_PER_CYCLE=10
JOB_SCRAPER_LLM_MAX_OUTPUT_TOKENS=6000
JOB_SCRAPER_LINKEDIN_DESCRIPTION_LIMIT=10
JOB_SCRAPER_INDEED_MAX_WORKERS=3
JOB_SCRAPER_VERBOSE_LOGGING=false

# Optional email notifications
JOB_SCRAPER_EMAIL_ENABLED=false
JOB_SCRAPER_EMAIL_FROM=
JOB_SCRAPER_EMAIL_PASSWORD=
JOB_SCRAPER_EMAIL_TO=
JOB_SCRAPER_EMAIL_SMTP=
